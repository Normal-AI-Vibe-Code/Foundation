# HTTPS for a hosted Foundation (deploy/compose.yml). Caddy gets and renews the certificate itself.
# It passes the Host it was asked for and X-Forwarded-For on; sockets (/sync, /huddle, chat) and long
# uploads go through the same proxy with nothing more to set (it puts no time limit on either).
{$FOUNDATION_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	reverse_proxy foundation:4410
}
