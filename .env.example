# Foundation server — every integration is off until its key is set. See SPEC.md §6.

# FOUNDATION_PORT=4410
# FOUNDATION_DATA_DIR=data
# FOUNDATION_PUBLIC_URL=http://localhost:4410
# FOUNDATION_CLIENT_URL=http://localhost:1430

# who may sign in: emails or @domains
FOUNDATION_ALLOWLIST=@formindustries.com,@normallab.co,josh.leong@gmail.com
FOUNDATION_ADMIN_EMAILS=josh.leong@gmail.com
# dev login (name + allowlisted email, no password) — set 0 on shared servers
FOUNDATION_DEV_LOGIN=1

# Sign in with Google through flowform-server: the flowform client's own
# sign-in, with the same server and the same Google client. Needs no secret here.
# Foundation's server must be on a loopback address with a port (flowform's rule).
# FLOWFORM_URL=https://server.formresearch.ai
# FLOWFORM_ADMIT_VIEWERS=0
# Flowform import (docs/flowform-import.md): only for --media-flowform, a Flowform session of a
# person in the rooms. Set it in your shell for the run; don't keep it here.
# FLOWFORM_IMPORT_TOKEN=
# Optional: Foundation's own Google client instead (redirect URI: <public url>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# agent: subscription runtime needs only `claude` on PATH; API runtime needs a key
ANTHROPIC_API_KEY=
# FOUNDATION_AGENT_MODEL=claude-opus-5-5
# FOUNDATION_CLAUDE_CLI=claude

# service token for other services/agents (≥ 32 chars)
FOUNDATION_SERVICE_TOKEN=

# Slack — create the app from docs/slack-app-manifest.yml.
# Bot token: Slack channel cards (read, post, links, huddle invites) and Hermes DMs.
SLACK_BOT_TOKEN=
# The Slack board (a section per channel, live): run the Slack app with `npm run slack`
# (apps/slack-agent). It reads FOUNDATION_SERVICE_TOKEN above from this file, forwards
# Slack's events to Foundation and lends it the bot token over loopback, so
# SLACK_BOT_TOKEN can stay empty on this computer.
# FOUNDATION_SLACK_CURATE_MIN_MS=600000   an agent rewrites a channel's summary at most this often
# FOUNDATION_SLACK_CURATE_PER_HOUR=20     and at most this many agent turns an hour, all channels
# User token (search:read): Slack results in ⌘K
SLACK_USER_TOKEN=

# huddles: browsers connect peer to peer; STUN finds a route. Add a TURN server
# for people behind strict NATs, e.g. [{"urls":"turn:turn.example.com:3478","username":"…","credential":"…"}]
# FOUNDATION_ICE_SERVERS=

# Meshy (api.meshy.ai): the Character studio draws, models, rigs and animates the council's characters with it.
# Every stage is a person's press on a character's card and says its cost first; without a key nothing can be pressed.
MESHY_API_KEY=
# the image model for sheets and views (nano-banana-pro needs Meshy's Pro plan; nano-banana-2-1 costs less)
# MESHY_IMAGE_MODEL=nano-banana-pro

# GitHub
GITHUB_TOKEN=
FOUNDATION_GITHUB_ORG=

# company connectors
FACTORYFORM_URL=http://127.0.0.1:3001
# BomForm, two ways. Direct (live): its MCP endpoint + key (+ its private CA)
BOMFORM_MCP_URL=
BOMFORM_API_KEY=
# NODE_EXTRA_CA_CERTS=/path/to/bomform-ca.pem
# …or the Airform Data Room's daily copy, read-only (GET /api/foundation/bomform,
# bearer = the Data Room's FOUNDATION_READ_TOKEN). Local: npm run services runs it on :3010
DATAROOM_BOMFORM_URL=
DATAROOM_READ_TOKEN=
DATAROOM_URL=https://airformdata.com
VISION_URL=http://localhost:1420
CREATION_URL=http://localhost:5173

# The oldest desktop/web client this server still works with (x.y.z). Unset: any.
# An older client is told to update (its update card stays up, without Later or Skip) and gets no board socket.
# Set it only after that version is published to the update feed (npm run release -- publish).
# FOUNDATION_MIN_CLIENT=0.4.0
